# Streamlit Cloud 배포 시: 이 파일을 참고해
# Streamlit Cloud 대시보드 → App settings → Secrets 에 붙여넣으세요.
#
# 로컬 실행은 `.env` 파일을 그대로 쓰면 됩니다.
# 이 파일을 secrets.toml로 복사해도 로컬에서 동작합니다 (단, secrets.toml은 gitignore).

GEMINI_API_KEY = "여기에_Gemini_API_키를_붙여넣으세요"
PUBLIC_DATA_API_KEY = "여기에_공공데이터포털_인증키를_붙여넣으세요"

# 비밀번호 게이트 (지우면 게이트 비활성)
APP_PASSWORD = "0411"
